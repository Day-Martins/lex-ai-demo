# Banco: PostgreSQL em produção; SQLite local quando esta variável não existe.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/lex_ai

# Administrador inicial. A senha só é usada se o usuário ainda não existir.
LEX_ADMIN_USERNAME=dmt
LEX_ADMIN_NAME=DMT Administrador
LEX_ADMIN_EMAIL=administrador@exemplo.com
LEX_ADMIN_INITIAL_PASSWORD=defina-uma-senha-forte

# Endereço público usado nos links enviados por e-mail.
LEX_PUBLIC_URL=https://lex.54-94-43-149.sslip.io

# Servidor de e-mail.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USERNAME=usuario-smtp
SMTP_PASSWORD=senha-smtp
SMTP_FROM=LEX AI <nao-responda@exemplo.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
